# Copy to .env and fill in. Every collector skips its source when the key is missing.

# OpenSky account -> "API client" (OAuth2 client credentials). Unlocks /flights endpoints.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# AeroDataBox (scheduled times). Channel: rapidapi | apimarket | direct
AERODATABOX_KEY=
AERODATABOX_CHANNEL=rapidapi
# Delete raw AeroDataBox files after N days (terms art. 5.5: 7 unless you have an exemption). 0 = keep.
AERODATABOX_RETAIN_DAYS=7

# Optional: LLM ops briefing in the dashboard
ANTHROPIC_API_KEY=
